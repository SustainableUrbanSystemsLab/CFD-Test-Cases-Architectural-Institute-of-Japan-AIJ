   "media_type": "application/json",
   "description": "the five cases: id, title, frame, units, counts, engine status, links",
   "schema": "https://sustainableurbansystems.com/CFD-Test-Cases-Architectural-Institute-of-Japan-AIJ/api/schemas/cases.schema.json"
  },
  {
