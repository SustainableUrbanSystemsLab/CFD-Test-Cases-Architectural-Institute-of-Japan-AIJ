   "method": "GET",
   "media_type": "application/json",
   "description": "every endpoint and file with its size and SHA-256, versions, compatibility policy, changelog, licence, citation",
   "schema": "https://sustainableurbansystems.com/CFD-Test-Cases-Architectural-Institute-of-Japan-AIJ/api/schemas/index.schema.json"
  },
  {
