{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://sustainableurbansystems.com/CFD-Test-Cases-Architectural-Institute-of-Japan-AIJ/api/schemas/geometry-index.schema.json",
 "title": "All geometry",
 "description": "Every STL of every case in one list, and the archive that holds them.",
 "type": "object",
 "required": [
  "$schema",
  "schema_version",
  "data_version",
  "license",
  "files",
  "archive"
 ],
 "properties": {
  "$schema": {
   "type": "string",
   "format": "uri"
  },
  "schema_version": {
   "type": "string",
   "pattern": "^\\d+\\.\\d+\\.\\d+$",
   "description": "the API's version (semantic versioning); see index.json changelog"
  },
  "data_version": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$",
   "description": "SHA-256 over every served measurement, geometry and score file; changes when, and only when, the data does"
  },
  "license": {
   "const": "CC-BY-4.0",
   "description": "SPDX identifier of the data's licence"
  },
  "archive": {
   "type": "object",
   "required": [
    "url",
    "path",
    "media_type",
    "bytes",
    "sha256"
   ],
   "properties": {
    "url": {
     "type": "string",
     "format": "uri",
     "description": "absolute URL; the ?v= query is the file's SHA-256 prefix, so a changed file has a new URL"
    },
    "path": {
     "type": "string",
     "description": "path below the API base"
    },
    "media_type": {
     "type": "string"
    },
    "bytes": {
     "type": "integer",
     "minimum": 0
    },
    "sha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    }
   }
  },
  "files": {
   "type": "array",
   "items": {
    "allOf": [
     {
      "type": "object",
      "required": [
       "url",
       "path",
       "media_type",
       "bytes",
       "sha256"
      ],
      "properties": {
       "url": {
        "type": "string",
        "format": "uri",
        "description": "absolute URL; the ?v= query is the file's SHA-256 prefix, so a changed file has a new URL"
       },
       "path": {
        "type": "string",
        "description": "path below the API base"
       },
       "media_type": {
        "type": "string"
       },
       "bytes": {
        "type": "integer",
        "minimum": 0
       },
       "sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
       }
      }
     },
     {
      "type": "object",
      "required": [
       "case",
       "configuration",
       "archive_name",
       "units",
       "frame",
       "triangles"
      ],
      "properties": {
       "case": {
        "enum": [
         "A",
         "B",
         "C",
         "D",
         "E"
        ]
       },
       "configuration": {
        "type": "string"
       },
       "archive_name": {
        "type": "string"
       },
       "units": {
        "type": "string"
       },
       "frame": {
        "type": "object",
        "required": [
         "origin",
         "x",
         "y",
         "z"
        ],
        "properties": {
         "origin": {
          "type": "string"
         },
         "x": {
          "type": "string"
         },
         "y": {
          "type": "string"
         },
         "z": {
          "type": "string"
         }
        }
       },
       "triangles": {
        "type": "integer"
       },
       "watertight": {
        "type": "boolean"
       }
      }
     }
    ]
   }
  }
 }
}
