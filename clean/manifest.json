 "columns": {
  "case_id": {
   "unit": "",
   "meaning": "AIJ UWE case letter: A, B, C, D or E"
  },
  "config": {
   "unit": "",
   "meaning": "configuration within the case: 'default' (A, B, D); Case C centre building '0D' | '1D' | '2D'; Case E 'bc' (before construction) | 'ac' (after construction)"
  },
  "instrument": {
   "unit": "",
   "meaning": "'split_fibre' = hot-wire split-fibre probe, vector components; 'thermistor' = omnidirectional scalar speed"
  },
  "point_id": {
   "unit": "",
   "meaning": "the tunnel's own measurement point number (No.); shared across configurations and directions of a case"
  },
  "wind_direction_deg": {
   "unit": "deg",
   "meaning": "the case's wind direction label. A-D: the AIJ turntable angle WD (0 = +x). E: meteorological FROM-direction, clockwise from north (N = 0, E = 90). The flow vector per direction is in directions.csv"
  },
  "wind_direction": {
   "unit": "",
   "meaning": "compass name of the FROM-direction (Case E only; '' elsewhere)"
  },
  "x": {
   "unit": "m",
   "meaning": "case frame (SCHEMA.md): +x = streamwise at WD = 0 for A-D, +x = east for E; model-scale metres for A-D, full-scale metres for E"
  },
  "y": {
   "unit": "m",
   "meaning": "case frame: +y lateral (A-D), +y = north (E)"
  },
  "z": {
   "unit": "m",
   "meaning": "height above the ground plane"
  },
  "U": {
   "unit": "m/s",
   "meaning": "mean velocity component along +x"
  },
  "V": {
   "unit": "m/s",
   "meaning": "mean velocity component along +y (positive toward +y in EVERY case; Case B's published sign is flipped, see manifest transform)"
  },
  "W": {
   "unit": "m/s",
   "meaning": "mean velocity component along +z"
  },
  "uu": {
   "unit": "m^2/s^2",
   "meaning": "variance of the x-component fluctuation <u'u'> (Case A publishes rms; squared here)"
  },
  "vv": {
   "unit": "m^2/s^2",
   "meaning": "variance <v'v'>"
  },
  "ww": {
   "unit": "m^2/s^2",
   "meaning": "variance <w'w'>"
  },
  "k": {
   "unit": "m^2/s^2",
   "meaning": "turbulent kinetic energy as published (= (uu+vv+ww)/2 wherever all three variances exist; checked)"
  },
  "Vs": {
   "unit": "m/s",
   "meaning": "mean omnidirectional SCALAR wind speed from a thermistor anemometer. NOT |mean velocity vector| (Case D's split-fibre |U| column is dropped, see log)"
  },
  "velocity_ratio": {
   "unit": "-",
   "meaning": "Case E: Vs / U_ref with U_ref = the approach-flow speed at z = 15.9 m (full scale); see manifest cases.E.normalisation"
  }
 },
